<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Badge -->
    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Günün Kelimesi"
        android:textSize="9sp"
        android:textColor="#AAFFFFFF"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true" />

    <!-- Center Content Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true">

        <!-- Ottoman Calligraphy -->
        <TextView
            android:id="@+id/widget_ottoman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حزن"
            android:textSize="28sp"
            android:textColor="#FFB300"
            android:gravity="center" />

        <!-- Turkish Word -->
        <TextView
            android:id="@+id/widget_tr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hüzün"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="2dp"
            android:gravity="center" />

        <!-- Meaning -->
        <TextView
            android:id="@+id/widget_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İç sıkıntısı, gam; tatlı bir kederle karışık derin üzüntü."
            android:textSize="11sp"
            android:textColor="#CCCCCC"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>
